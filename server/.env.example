# ── DATABASE CONFIGURATION ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=celeste_db

# ── JWT CONFIGURATION ────────────────────────────────────────────────────────
# Use a strong random string for JWT_SECRET (min 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production

# ── CORS CONFIGURATION ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173,http://localhost:5174
# Production: https://yourdomain.com
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# ── RAZORPAY CONFIGURATION ───────────────────────────────────────────────────
# Get these from Razorpay dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── SERVER CONFIGURATION ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── EMAIL CONFIGURATION (for password reset, notifications) ────────────────────
# Optional: Configure if using email features
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@celeste.com

# ── GOOGLE OAUTH (optional) ──────────────────────────────────────────────────
# Get these from Google Cloud Console
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret